# Infraestructura
VM_NAME=lempTuNombre

# Base de datos MariaDB
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=cambiar_clave_bd_ejemplo
DB_ROOT_PASSWORD=cambiar_clave_root_ejemplo

# WordPress
WP_URL=https://localhost:8443
WP_TITLE="Blog de TuNombre"
WP_LOCALE=es_ES
WP_TIMEZONE=Europe/Madrid

# Usuarios de WordPress (el administrador NO puede llamarse admin)
WP_ADMIN_USER=gestor_miriam
WP_ADMIN_PASSWORD=cambiar_clave_admin_ejemplo
WP_ADMIN_EMAIL=admin@example.com

WP_EDITOR_USER=editor_user
WP_EDITOR_PASSWORD=cambiar_clave_editor_ejemplo
WP_EDITOR_EMAIL=editor@example.com

WP_AUTHOR_USER=autor_user
WP_AUTHOR_PASSWORD=cambiar_clave_autor_ejemplo
WP_AUTHOR_EMAIL=autor@example.com

WP_CONTRIBUTOR_USER=colaborador_user
WP_CONTRIBUTOR_PASSWORD=cambiar_clave_colab_ejemplo
WP_CONTRIBUTOR_EMAIL=colaborador@example.com

# Tema y plugins
WP_THEME=astra
WP_PLUGINS="limit-login-attempts-reloaded classic-editor"
